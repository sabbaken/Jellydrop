# --- Required ---------------------------------------------------------------

# Bot token from @BotFather (TG_BOT_SECRET is accepted as an alias)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (ask @userinfobot). The bot silently ignores
# everyone else.
ALLOWED_TELEGRAM_USER_ID=

# --- Jellyfin ----------------------------------------------------------------

# Internal compose-network address of Jellyfin (no published API port needed)
JELLYFIN_URL=http://jellyfin:8096

# Dashboard -> API Keys. If empty, library refresh is skipped (with a warning).
JELLYFIN_API_KEY=

# --- Core (defaults shown) ----------------------------------------------------

DOWNLOAD_CONCURRENCY=2
DB_PATH=/data/queue.db
STAGING_DIR=/media/staging
LIBRARY_DIR=/media/library
PROGRESS_EDIT_INTERVAL_MS=3000

# --- Optional features (off by default, see spec §13) --------------------------

# Netscape cookies file for private/age-gated content; mounted via ./data
#COOKIES_FILE=/data/cookies.txt

# Skip downloads larger than this (yt-dlp --max-filesize syntax, e.g. 2G)
#MAX_FILESIZE=

# Enable the /audio command (-x --audio-format opus), files go to LIBRARY_DIR/audio
ENABLE_AUDIO_MODE=false

# Periodically delete library files older than CLEANUP_AFTER_DAYS
ENABLE_AUTO_CLEANUP=false
CLEANUP_AFTER_DAYS=30

# Append a deep link to the Jellyfin item card to the final "done" message.
# JELLYFIN_PUBLIC_URL is the address reachable from your devices (deep links
# built from the internal compose URL would not open on a phone).
ENABLE_JELLYFIN_DEEPLINK=false
#JELLYFIN_PUBLIC_URL=http://192.168.1.10:8096

# Path to the yt-dlp binary (override for local development)
#YTDLP_PATH=yt-dlp
